# Groq API key for lesson/quiz/doubt generation (free — https://console.groq.com/keys)
GROQ_API_KEY=gsk_...

# Optional: override the Groq open-source model used
GROQ_MODEL=llama-3.3-70b-versatile

# Supabase project (free — https://supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
